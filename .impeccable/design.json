      "css": ".ds-field{display:flex;flex-direction:column;gap:6px;color:var(--ink-soft,#5c6878);font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;font-size:13px;font-weight:700}.ds-input{font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;font-size:14px;font-weight:400;line-height:1.5;padding:.55rem .75rem;border:1px solid var(--input-line,#8c9aad);border-radius:var(--radius-md,6px);background:var(--surface,#fff);color:var(--ink,#1f2d3d);transition:border-color .15s ease-in-out,box-shadow .15s ease-in-out}.ds-input:focus,.ds-input:focus-visible{outline:0;border-color:var(--brand-blue,#315dcc);box-shadow:0 0 0 3px #315dcc26}@media(max-width:640px){.ds-input{font-size:16px}}@media(prefers-reduced-motion:reduce){.ds-primary,.ds-outline,.ds-input{transition-duration:.01ms!important}}"
