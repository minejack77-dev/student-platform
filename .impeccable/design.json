      "description": "Основное действие. Размеры и состояния извлечены из theme.css и Bootstrap.",
      "html": "<button class=\"ds-primary\" type=\"button\">Создать группу</button>",
      "css": ".ds-primary{font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;font-size:14px;font-weight:600;line-height:1.5;min-height:38px;padding:8px 14px;border-radius:var(--radius-md,6px);border:1px solid;cursor:pointer;transition:color .15s ease-in-out,background-color .15s ease-in-out,border-color .15s ease-in-out,box-shadow .15s ease-in-out;background:var(--brand-blue,#315dcc);border-color:var(--brand-blue,#315dcc);color:#fff}.ds-primary:hover,.ds-primary:active{background:var(--brand-blue-strong,#244aa7);border-color:var(--brand-blue-strong,#244aa7)}.ds-primary:disabled{background:#596b97;border-color:#596b97;opacity:.65;pointer-events:none}.ds-primary:focus-visible,.ds-outline:focus-visible{outline:3px solid var(--brand-blue,#315dcc);outline-offset:3px}@media(max-width:640px){.ds-primary{min-height:44px}}@media(prefers-reduced-motion:reduce){.ds-primary,.ds-outline,.ds-input{transition-duration:.01ms!important}}"
