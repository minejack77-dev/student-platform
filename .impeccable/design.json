      "html": "<nav class=\"ds-tabs\" aria-label=\"Разделы страницы\"><a class=\"ds-tab\" href=\"#overview\" aria-current=\"page\">Обзор</a><a class=\"ds-tab\" href=\"#results\">Результаты</a></nav>",
      "css": ".ds-tabs{display:flex;flex-wrap:wrap;gap:20px;border-bottom:1px solid var(--line,#dbe1e9);font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif}.ds-tab{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:10px 0;border-bottom:2px solid transparent;color:var(--ink-soft,#5c6878);font-size:14px;font-weight:600;line-height:1.5;text-decoration:none}.ds-tab:hover{color:var(--brand-blue-strong,#244aa7)}.ds-tab[aria-current=page]{color:var(--brand-blue-strong,#244aa7);border-bottom-color:var(--brand-blue,#315dcc)}.ds-tab:focus-visible{outline:3px solid var(--brand-blue,#315dcc);outline-offset:3px}"
